; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

_global_script_classes=[  ]
_global_script_class_icons={

}

[application]

config/name="2584 Fibonacci 2048"
config/description="2584 aka 2048 in Fibonacci numbers"
run/main_scene="res://Scenes/MainMenu.tscn"
boot_splash/image="res://Graphics/Telos_Delphia.png"
boot_splash/bg_color=Color( 0.144531, 0.144531, 0.144531, 1 )
config/icon="res://Graphics/icon.png"

[display]

window/size/width=480
window/size/height=720
window/size/resizable=false
window/handheld/orientation="portrait"
window/stretch/mode="2d"
window/stretch/aspect="keep"

[rendering]

quality/driver/driver_name="GLES2"
vram_compression/import_etc=true
vram_compression/import_etc2=false
environment/default_environment="res://Materials/default_env.tres"
